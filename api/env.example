# Live Google Apps Script — only for migrate-from-gas.js
GAS_API_URL=https://script.google.com/macros/s/YOUR_DEPLOYMENT/exec
GAS_ADMIN_USER=admin
GAS_ADMIN_PASSWORD=your-erp-password
