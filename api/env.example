# Copy to api/.env locally (never commit secrets)

PORT=3000
CORS_ORIGINS=https://erp.amzprints.com,https://amzprints.com,https://amz-prints-erp-new.vercel.app,http://localhost:5173

SUPABASE_URL=https://YOUR-PROJECT.supabase.co
